{
	"name": "o2 Retro Terminal",
	"description": "A CRT terminal look for Steam: phosphor colours, scanlines and glow. Nothing is loaded from the internet.",
	"author": "Ryder (o2cord)",
	"version": "1.0.0",
	"tags": [
		"Retro",
		"Terminal",
		"CRT",
		"Dark"
	],
	"UseDefaultPatches": false,
	"Patches": [
		{
			"MatchRegexString": "^Steam$",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^OverlayBrowser_Browser$",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^SP Overlay:",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "Menu$",
			"TargetCss": [
				"retro.css",
				"terminal.css",
				"menus.css"
			]
		},
		{
			"MatchRegexString": "Supernav$",
			"TargetCss": [
				"retro.css",
				"terminal.css",
				"menus.css"
			]
		},
		{
			"MatchRegexString": "^notificationtoasts_",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^SteamBrowser_Find$",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^OverlayTab\\d+_Find$",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^Steam Big Picture Mode$",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^QuickAccess_",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^MainMenu_",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": ".friendsui-container",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": ".ModalDialogPopup",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": ".FullModalOverlay",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^https?://(store\\.steampowered|steamcommunity|help\\.steampowered|checkout\\.steampowered)\\.com(/.*)?$",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		},
		{
			"MatchRegexString": "^Sign in to Steam",
			"TargetCss": [
				"retro.css",
				"terminal.css"
			]
		}
	],
	"Conditions": {
		"Phosphor colour": {
			"description": "> The colour of the screen, like the profiles in cool-retro-term.\n\n- Amber / Green / Apple ][ / Red / Blue / Cyan / Plasma / VGA grey",
			"default": "Amber",
			"values": {
				"Amber": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/amber.css"
					}
				},
				"Green": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/green.css"
					}
				},
				"Apple ][": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/apple.css"
					}
				},
				"Red": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/red.css"
					}
				},
				"Blue": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/blue.css"
					}
				},
				"Cyan": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/cyan.css"
					}
				},
				"Plasma": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/plasma.css"
					}
				},
				"VGA grey": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/vga.css"
					}
				}
			}
		},
		"Restyle strength": {
			"description": "> How much of Steam's own interface (panels, lists, text, buttons) is recoloured into the phosphor colour. Pictures keep their real colours. 100 = fully one colour, 0 = Steam's own colours. Applies to new windows; restart Steam to see it everywhere.",
			"default": "85",
			"slider": {
				"min": 0,
				"max": 100,
				"step": 5,
				"unit": "%",
				"cssVariable": "--o2-restyle"
			}
		},
		"Phosphor tint": {
			"description": "> A phosphor-coloured film over the whole screen, pictures included. 0 leaves pictures and Steam's colours as they are.",
			"default": "0",
			"slider": {
				"min": 0,
				"max": 100,
				"step": 5,
				"unit": "%",
				"cssVariable": "--o2-tint"
			}
		},
		"Colour shift": {
			"description": "> Pulls every colour on screen, pictures included, toward the phosphor colour. 0 leaves colours alone.",
			"default": "0",
			"slider": {
				"min": 0,
				"max": 100,
				"step": 5,
				"unit": "%",
				"cssVariable": "--o2-hue"
			}
		},
		"Colour mode": {
			"description": "> Keep colours: Steam keeps its own colours with a phosphor tint over them.\n\n- Black and white: everything is turned grey first, so the screen is one colour like a real terminal.",
			"default": "Keep colours",
			"values": {
				"Keep colours": {},
				"Black and white": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/mono.css"
					}
				}
			}
		},
		"Scanlines": {
			"description": "> How visible the scanlines are.",
			"default": "Normal",
			"values": {
				"Off": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/no-scanlines.css"
					}
				},
				"Normal": {},
				"Strong": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/strong-scanlines.css"
					}
				}
			}
		},
		"Text glow": {
			"description": "> The soft glow around text.",
			"default": "On",
			"values": {
				"On": {},
				"Off": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/no-glow.css"
					}
				}
			}
		},
		"Flicker": {
			"description": "> A slow screen flicker. Stops if Windows has reduced motion turned on.",
			"default": "Off",
			"values": {
				"Off": {},
				"On": {
					"TargetCss": {
						"affects": [
							".*"
						],
						"src": "profiles/flicker.css"
					}
				}
			}
		}
	},
	"o2Restyle": {
		"fg": {
			"condition": "Phosphor colour",
			"default": "Amber",
			"values": {
				"Amber": "#ff8100",
				"Green": "#0ccc68",
				"Apple ][": "#4dff6b",
				"Red": "#ff3b30",
				"Blue": "#7fb4ff",
				"Cyan": "#52f7ff",
				"Plasma": "#ff9bd6",
				"VGA grey": "#c0c0c0"
			}
		},
		"strength": {
			"condition": "Restyle strength",
			"default": 85
		},
		"square": true,
		"noShadows": true
	}
}